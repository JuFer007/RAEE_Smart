# ============================================================
# RAEE Smart - Plantilla de configuracion central
# ============================================================
# Copiar a .env y ajustar los valores segun el entorno local.

# ---------- Backend (Spring Boot) ----------
BACKEND_PORT=8080
PORT_PDF=3007
DB_URL=jdbc:postgresql://localhost:5432/RAEE_Smart
DB_USERNAME=postgres
DB_PASSWORD=123456
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006,http://localhost:8081,http://127.0.0.1:8000
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://10.*.*.*:*,http://192.168.*.*:*,http://172.*.*.*:*
UPLOADS_DIR=./uploads/raee-smart
CERT_VERIFICATION_BASE_URL=http://localhost:8080/api/certificados/verificar
CERT_PDF_BASE_URL=http://localhost:3007
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ---------- Servicio de IA (FastAPI) ----------
IA_HOST=0.0.0.0
IA_PORT=8000
IA_DEMO_HOST=127.0.0.1
IA_DEMO_PORT=8010
IA_RUTA_MODELO=model_weights/raee_mobilenetv2_v1.h5
IA_RUTA_CATEGORIAS=model_weights/categorias.json
IA_TAMANO_IMAGEN=224
IA_BASE_URL=http://127.0.0.1:8000

# ---------- App movil (Expo) ----------
# En desarrollo la URL del backend se detecta automaticamente desde el
# servidor de Expo (sirve para cualquier PC, red Wi-Fi, emulador o web).
# Solo definir esta variable para produccion, tunel o backend en otro host:
# EXPO_PUBLIC_API_URL=https://api.tudominio.com/api
EXPO_PUBLIC_USAR_DATOS_PRUEBA=false
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright/style.json

# ---------- Panel web (Vite) ----------
# En desarrollo usa el mismo host desde el que se abre el panel.
# Definir solo si el backend esta en otro host o en produccion:
# VITE_API_BASE_URL=https://api.tudominio.com/api
VITE_PDF_BASE_URL=http://localhost:3007
